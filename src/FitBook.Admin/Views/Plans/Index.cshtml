@model List<MembershipPlan>
@{ ViewData["Title"] = "Ceník"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ceník permanentek</h1>
    <a class="btn btn-fitbook" asp-action="Create">+ Nová permanentka</a>
</div>

<table class="table align-middle bg-white">
    <thead><tr><th>Název</th><th>Typ</th><th>Platnost</th><th>Cena</th><th>Stav</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsActive ? "" : "text-muted")">
            <td>@p.Name</td>
            <td>@(p.Kind == PlanKind.Unlimited ? "neomezená" : $"{p.Entries} vstupů")</td>
            <td>@p.ValidityDays dní</td>
            <td>@p.Price.ToString("N0") Kč</td>
            <td>@(p.IsActive ? "v prodeji" : "vyřazená")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Upravit</a>
                <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                    <button class="btn btn-sm btn-outline-@(p.IsActive ? "danger" : "success")">@(p.IsActive ? "Vyřadit" : "Obnovit")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="navbar-text me-3 small">
                @User.Identity?.Name
                <span class="badge bg-light text-dark ms-1">@(User.IsInRole(FitBook.Admin.Data.Roles.Admin) ? "Admin" : "Recepce")</span>
            </span>
        </li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                <button type="submit" class="btn btn-sm btn-outline-light">Odhlásit</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-light" asp-area="Identity" asp-page="/Account/Login">Přihlásit</a>
        </li>
    }
</ul>

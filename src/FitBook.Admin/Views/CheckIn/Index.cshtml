@model CheckInViewModel
@inject BusinessClock Clock
@{ ViewData["Title"] = "Recepce"; }

<h1 class="h3 mb-4">Recepce – odbavení vstupu</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <form method="get" class="mb-3" role="search">
            <div class="input-group input-group-lg">
                <input class="form-control" name="q" value="@Model.Query" placeholder="Jméno nebo e-mail zákazníka" aria-label="Hledat zákazníka" autofocus />
                <button class="btn btn-fitbook">Hledat</button>
            </div>
        </form>

        @foreach (var r in Model.Results)
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <a class="fw-semibold" asp-controller="Customers" asp-action="Details" asp-route-id="@r.Id">@r.Name</a>
                        <div class="small text-muted">
                            @(r.ActivePlan is null ? "bez platné permanentky" : $"{r.ActivePlan}, do {r.ValidTo:d. M. yyyy}")
                        </div>
                    </div>
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="customerId" value="@r.Id" />
                        <button class="btn @(r.ActivePlan is null ? "btn-outline-secondary" : "btn-success")">Odbavit</button>
                    </form>
                </div>
            </div>
        }
        @if (Model.Query is not null && Model.Results.Count == 0)
        {
            <p class="text-muted">Nikdo nenalezen. <a asp-controller="Customers" asp-action="Create">Přidat zákazníka</a></p>
        }
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold">Dnešní vstupy</div>
            <ul class="list-group list-group-flush">
                @foreach (var ch in Model.Recent)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@ch.Customer.Name</span>
                        <span class="text-muted">@Clock.ToLocal(ch.AtUtc).ToString("HH:mm")</span>
                    </li>
                }
                @if (Model.Recent.Count == 0) { <li class="list-group-item text-muted">Zatím nikdo.</li> }
            </ul>
        </div>
    </div>
</div>

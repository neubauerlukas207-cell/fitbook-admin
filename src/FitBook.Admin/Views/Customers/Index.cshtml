@model CustomerListViewModel
@{ ViewData["Title"] = "Zákazníci"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Zákazníci</h1>
    <a class="btn btn-fitbook" asp-action="Create">+ Nový zákazník</a>
</div>

<form method="get" class="mb-3" role="search">
    <input class="form-control" name="q" value="@Model.Query" placeholder="Hledat podle jména nebo e-mailu…" aria-label="Hledat" />
</form>

<table class="table table-hover align-middle bg-white">
    <thead><tr><th>Jméno</th><th>E-mail</th><th>Platná permanentka</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Customers)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
            <td class="text-muted">@c.Email</td>
            <td>
                @if (c.ActivePlan is null)
                {
                    <span class="badge text-bg-secondary">bez permanentky</span>
                }
                else
                {
                    <span class="badge text-bg-success">@c.ActivePlan</span>
                    <span class="small text-muted">
                        do @c.ValidTo?.ToString("d. M. yyyy")@(c.RemainingEntries is { } left ? $", zbývá {left}" : "")
                    </span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Customers.Count == 0)
{
    <p class="text-muted">Nikdo nenalezen.</p>
}
